chmod 400, chmod u+r,u-wx,go-rwx
chmod ugo +- rwx, chmod u+r,u-wx,go-rwx
chown <user>:<group> <file> => update user,group owner of a file
chgrp <group> <file> => update group owner of the file
chown,chmod -R     => to update owner,perm recursivley for a dir
